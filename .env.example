# ResearchRadar does not load this file implicitly.
# Prefer `research-radar secrets set ...` so credentials go into Keychain locally.
# For a local smoke run, pass `--secret-source env --env-file .env` explicitly.
#
# These names document the expected secret values for cloud secret managers.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
